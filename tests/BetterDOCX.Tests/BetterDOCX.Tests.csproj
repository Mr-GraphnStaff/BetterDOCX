<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BetterDOCX.Model\BetterDOCX.Model.csproj" />
    <ProjectReference Include="..\..\src\BetterDOCX.Word\BetterDOCX.Word.csproj" />
    <ProjectReference Include="..\..\src\BetterDOCX.Validation\BetterDOCX.Validation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\schemas\document-specification.schema.json"
          Link="Fixtures\document-specification.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\examples\valid-professional-brief.json"
          Link="Fixtures\valid-professional-brief.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\examples\invalid-empty-bullets.json"
          Link="Fixtures\invalid-empty-bullets.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
